# Base de données (docker-compose expose Postgres sur le port 5433)
DATABASE_URL=postgresql+psycopg://riding:riding@localhost:5433/ridingfactory
SECRET_KEY=change-me-in-production
SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Intégrations optionnelles
# OPENAI_API_KEY=sk-...          # assistant IA en langage naturel (sinon moteur de règles)
# STRIPE_SECRET_KEY=sk_test_...  # paiement en ligne (sinon paiement simulé)
# WORLDTIDES_API_KEY=...         # marées réelles (sinon modèle harmonique)

# Identité pour les devis / factures
COMPANY_NAME=Riding Factory
COMPANY_ADDRESS=Saint-Hilaire-de-Riez, Vendée
COMPANY_SIRET=000 000 000 00000
COMPANY_VAT_NUMBER=FR00000000000
